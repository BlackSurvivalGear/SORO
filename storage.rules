rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member() { return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)); }
    function approved() { return signedIn() && member().data.status == 'approved'; }

    match /crew-images/{uid}/{fileName} {
      allow read: if approved();
      allow create: if approved()
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update: if false;
      allow delete: if approved() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
