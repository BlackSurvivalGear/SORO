rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(uid) { return get(/databases/$(database)/documents/members/$(uid)); }
    function isOwner() { return signedIn() && member(request.auth.uid).data.status == 'approved' && member(request.auth.uid).data.role == 'owner'; }
    function isAdmin() { return signedIn() && member(request.auth.uid).data.status == 'approved' && member(request.auth.uid).data.role in ['owner', 'admin']; }
    function approved() { return signedIn() && member(request.auth.uid).data.status == 'approved'; }

    match /members/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if (isOwner()
          && resource.data.role != 'owner'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['member', 'admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt']))
        || (isAdmin()
          && !isOwner()
          && resource.data.role == 'member'
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isOwner() && resource.data.role != 'owner';
    }

    function room(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)); }
    function canEnterRoom(roomId) {
      return approved() && (
        room(roomId).data.access == 'open'
        || room(roomId).data.createdBy == request.auth.uid
        || isOwner()
        || request.auth.uid in room(roomId).data.memberUids
      ) && room(roomId).data.status == 'active';
    }
    function canManageRoomDoc() {
      return isOwner() || (isAdmin() && resource.data.createdBy == request.auth.uid);
    }

    match /rooms/{roomId} {
      allow read: if approved();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.access in ['open','invite']
        && request.resource.data.status == 'active'
        && request.resource.data.memberUids is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['name','description','access','status','createdBy','createdByName','memberUids','createdAt','updatedAt']);
      allow update: if canManageRoomDoc()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.access in ['open','invite']
        && request.resource.data.status in ['active','closed']
        && request.resource.data.memberUids is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','access','status','memberUids','updatedAt']);
      allow delete: if canManageRoomDoc();

      match /messages/{messageId} {
        allow read: if canEnterRoom(roomId);
        allow create: if canEnterRoom(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['text','uid','displayName','createdAt','replyTo'])
          && (!request.resource.data.keys().hasAny(['replyTo'])
            || (request.resource.data.replyTo is map
              && request.resource.data.replyTo.keys().hasOnly(['id','displayName','text'])
              && request.resource.data.replyTo.id is string
              && request.resource.data.replyTo.displayName is string
              && request.resource.data.replyTo.text is string
              && request.resource.data.replyTo.text.size() <= 240));
        allow update: if false;
        allow delete: if isOwner() || (isAdmin() && room(roomId).data.createdBy == request.auth.uid);
      }
    }

    match /messages/{messageId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(['text', 'uid', 'displayName', 'createdAt', 'replyTo'])
        && (!request.resource.data.keys().hasAny(['replyTo'])
          || (request.resource.data.replyTo is map
            && request.resource.data.replyTo.keys().hasOnly(['id', 'displayName', 'text'])
            && request.resource.data.replyTo.id is string
            && request.resource.data.replyTo.id.size() > 0
            && request.resource.data.replyTo.displayName is string
            && request.resource.data.replyTo.text is string
            && request.resource.data.replyTo.text.size() <= 240));
      allow update, delete: if false;
    }

    match /activityLog/{activityId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['sign_in', 'status_change', 'role_change']
        && request.resource.data.keys().hasOnly(['type','actorUid','actorName','memberUid','memberName','email','from','to','createdAt'])
        && request.resource.data.actorName is string
        && request.resource.data.memberUid is string
        && request.resource.data.memberName is string
        && request.resource.data.from is string
        && request.resource.data.to is string
        && ((request.resource.data.type == 'sign_in'
            && request.resource.data.memberUid == request.auth.uid
            && request.resource.data.keys().hasAll(['email'])
            && request.resource.data.email is string
            && request.resource.data.from == ''
            && request.resource.data.to == 'successful')
          || (request.resource.data.type in ['status_change','role_change']
            && isAdmin()
            && !request.resource.data.keys().hasAny(['email'])
            && request.resource.data.memberUid != request.auth.uid));
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
